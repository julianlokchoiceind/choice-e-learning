"use client";

import { useState, useEffect } from 'react';

/**
 * This component fixes hydration issues in the admin interface
 * by ensuring client-side rendering is properly synchronized with React's hydration
 */
export default function AdminHydrationFix({ children }: { children: React.ReactNode }) {
  // Use a state to track if the component is mounted on client
  const [isMounted, setIsMounted] = useState(false);
  
  // Set mounted state to true when component mounts on client side
  useEffect(() => {
    setIsMounted(true);
  }, []);
  
  // Show a minimal loading state until client-side hydration is complete
  if (!isMounted) {
    return (
      <div className="flex h-screen w-full items-center justify-center bg-slate-50">
        <div className="h-16 w-16 animate-spin rounded-full border-t-4 border-solid border-indigo-600"></div>
      </div>
    );
  }
  
  // When mounted on client, render children
  return <>{children}</>;
}
