{
  "name": "choice-e-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-prisma.mjs && prisma generate && next build",
    "start": "next start",
    "postinstall": "node scripts/clean-prisma.mjs && prisma generate",
    "vercel-build": "node scripts/clean-prisma.mjs && prisma generate && next build",
    "seed-courses": "node scripts/seed-courses.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "analyze": "node scripts/analyze-dependencies.mjs",
    "lint": "eslint src/app src/client src/server src/shared --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src/app src/client src/server src/shared --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css}'",
    "fix-eslint-errors": "node scripts/fix-eslint-errors.mjs",
    "check-all": "node scripts/check-all.mjs",
    "ts:check": "tsc --noEmit",
    "ts:fix": "node src/scripts/fix-typescript-errors.mjs",
    "ts:analyze": "node src/scripts/check-typescript-errors.mjs",
    "update-courses": "node scripts/update-courses-status.mjs",
    "restart-server": "npx prisma generate && npm run dev"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.1.1",
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.7.0",
    "@types/uuid": "^9.0.8",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "buffer": "^6.0.3",
    "dotenv": "^16.5.0",
    "events": "^3.3.0",
    "framer-motion": "^12.7.3",
    "jose": "^6.0.10",
    "next": "14.0.4",
    "next-auth": "^4.24.5",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.49.3",
    "react-icons": "^4.12.0",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "uuid": "^9.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.8",
    "@types/react": "^18.2.47",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "assert": "^2.1.0",
    "autoprefixer": "^10.4.16",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^6.2.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.2",
    "mongodb": "^6.16.0",
    "path": "^0.12.7",
    "path-browserify": "^1.0.1",
    "postcss": "^8.4.33",
    "prisma": "^6.7.0",
    "stream-http": "^3.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.31.1",
    "url": "^0.11.4",
    "webpack": "^5.99.8"
  }
}
